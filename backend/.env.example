# QualLoop Backend Environment Configuration
# Copy this file to .env in backend/ for local development overrides.

# Database URL for persistence of decisions and audit events.
# Default: Local SQLite database file (qualloop.db in backend directory).
# For PostgreSQL: postgresql://username:password@localhost:5432/qualloop
DATABASE_URL=sqlite:///qualloop.db

# Server Host & Port configuration
HOST=127.0.0.1
PORT=8000
